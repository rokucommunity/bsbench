' Target is `m.store.result` and `store["result"]`: deeper paths cost more per re-evaluation.
@suite()
namespace SpreadTrailingMembersDeepTarget
    sub setup()
        defaults = { x: 1, y: 2 }
        m.store = {}
        store = {}
    end sub

    @test("2 members: sets on m.store.result")
    sub _()
        m.store.result = {}
        m.store.result.append(defaults)
        m.store.result.a = 1
        m.store.result.b = 2
    end sub

    @test("2 members: append on m.store.result")
    sub _()
        m.store.result = {}
        m.store.result.append(defaults)
        m.store.result.append({ a: 1, b: 2 })
    end sub

    @test("2 members: sets on store[result]")
    sub _()
        store["result"] = {}
        store["result"].append(defaults)
        store["result"].a = 1
        store["result"].b = 2
    end sub

    @test("2 members: append on store[result]")
    sub _()
        store["result"] = {}
        store["result"].append(defaults)
        store["result"].append({ a: 1, b: 2 })
    end sub

    @test("4 members: sets on m.store.result")
    sub _()
        m.store.result = {}
        m.store.result.append(defaults)
        m.store.result.a = 1
        m.store.result.b = 2
        m.store.result.c = 3
        m.store.result.d = 4
    end sub

    @test("4 members: append on m.store.result")
    sub _()
        m.store.result = {}
        m.store.result.append(defaults)
        m.store.result.append({ a: 1, b: 2, c: 3, d: 4 })
    end sub

    @test("4 members: sets on store[result]")
    sub _()
        store["result"] = {}
        store["result"].append(defaults)
        store["result"].a = 1
        store["result"].b = 2
        store["result"].c = 3
        store["result"].d = 4
    end sub

    @test("4 members: append on store[result]")
    sub _()
        store["result"] = {}
        store["result"].append(defaults)
        store["result"].append({ a: 1, b: 2, c: 3, d: 4 })
    end sub

    @test("8 members: sets on m.store.result")
    sub _()
        m.store.result = {}
        m.store.result.append(defaults)
        m.store.result.a = 1
        m.store.result.b = 2
        m.store.result.c = 3
        m.store.result.d = 4
        m.store.result.e = 5
        m.store.result.f = 6
        m.store.result.g = 7
        m.store.result.h = 8
    end sub

    @test("8 members: append on m.store.result")
    sub _()
        m.store.result = {}
        m.store.result.append(defaults)
        m.store.result.append({ a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 })
    end sub

    @test("8 members: sets on store[result]")
    sub _()
        store["result"] = {}
        store["result"].append(defaults)
        store["result"].a = 1
        store["result"].b = 2
        store["result"].c = 3
        store["result"].d = 4
        store["result"].e = 5
        store["result"].f = 6
        store["result"].g = 7
        store["result"].h = 8
    end sub

    @test("8 members: append on store[result]")
    sub _()
        store["result"] = {}
        store["result"].append(defaults)
        store["result"].append({ a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 })
    end sub
end namespace
