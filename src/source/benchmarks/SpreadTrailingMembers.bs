        result = {}
        result.append(defaults)
        result["k-1"] = 1
        result["k-2"] = 2
        result["k-3"] = 3
        result["k-4"] = 4
        result["k-5"] = 5
        result["k-6"] = 6
        result["k-7"] = 7
        result["k-8"] = 8
