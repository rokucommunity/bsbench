' Informs how BrighterScript lowers AA members that follow a spread:
'     result = { ...defaults, a: 1, b: 2 }
' Option A: one property set per member      result.a = 1 : result.b = 2
' Option B: one append of a literal          result.append({ a: 1, b: 2 })
' The crossover point (if any) sets SPREAD_APPEND_THRESHOLD in the compiler.
' Secondary factors: a no-spread baseline, `m.result` and deeper targets (and building in a local temp instead),
' value kinds, and non-identifier keys (which lower to `result["k-1"] = 1` instead of a dotted set).
@suite()
namespace SpreadTrailingMembers
    sub setup()
        defaults = { x: 1, y: 2 }
        v1 = 1
        v2 = "two"
        v3 = 3.0
        v4 = true
        m.store = {}
        store = {}
    end sub

    @test("1 member: sets")
    sub _()
        result = {}
        result.append(defaults)
        result.a = 1
    end sub

    @test("1 member: append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ a: 1 })
    end sub

    @test("2 members: sets")
    sub _()
        result = {}
        result.append(defaults)
        result.a = 1
        result.b = 2
    end sub

    @test("2 members: append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ a: 1, b: 2 })
    end sub

    @test("3 members: sets")
    sub _()
        result = {}
        result.append(defaults)
        result.a = 1
        result.b = 2
        result.c = 3
    end sub

    @test("3 members: append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ a: 1, b: 2, c: 3 })
    end sub

    @test("4 members: sets")
    sub _()
        result = {}
        result.append(defaults)
        result.a = 1
        result.b = 2
        result.c = 3
        result.d = 4
    end sub

    @test("4 members: append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ a: 1, b: 2, c: 3, d: 4 })
