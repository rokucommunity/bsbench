        store["result"].b = 2
        store["result"].c = 3
        store["result"].d = 4
        store["result"].e = 5
        store["result"].f = 6
        store["result"].g = 7
        store["result"].h = 8
    end sub

    @test("store[result], 8 members: append literal")
    sub _()
        store["result"] = {}
        store["result"].append(defaults)
        store["result"].append({ a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 })
    end sub

    @test("4 string values: sets")
    sub _()
        result = {}
        result.append(defaults)
        result.a = "value1"
        result.b = "value2"
        result.c = "value3"
        result.d = "value4"
    end sub

    @test("4 string values: append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ a: "value1", b: "value2", c: "value3", d: "value4" })
    end sub

    @test("4 variable values: sets")
    sub _()
        result = {}
        result.append(defaults)
        result.a = v1
        result.b = v2
        result.c = v3
        result.d = v4
    end sub

    @test("4 variable values: append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ a: v1, b: v2, c: v3, d: v4 })
    end sub

    @test("4 nested AA values: sets")
    sub _()
        result = {}
        result.append(defaults)
        result.a = { id: 1 }
        result.b = { id: 2 }
        result.c = { id: 3 }
        result.d = { id: 4 }
    end sub

    @test("4 nested AA values: append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ a: { id: 1 }, b: { id: 2 }, c: { id: 3 }, d: { id: 4 } })
    end sub

    @test("2 string keys: indexed sets")
    sub _()
        result = {}
        result.append(defaults)
        result["k-1"] = 1
        result["k-2"] = 2
    end sub

    @test("2 string keys: append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ "k-1": 1, "k-2": 2 })
    end sub

    @test("4 string keys: indexed sets")
    sub _()
        result = {}
        result.append(defaults)
        result["k-1"] = 1
        result["k-2"] = 2
        result["k-3"] = 3
        result["k-4"] = 4
