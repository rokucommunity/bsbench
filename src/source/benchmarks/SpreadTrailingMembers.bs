    @test("no spread, 4 members: single literal")
    sub _()
        result = { x: 1, y: 2, a: 1, b: 2, c: 3, d: 4 }
    end sub

    @test("no spread, 4 members: leading literal + append(defaults)")
    sub _()
        result = { a: 1, b: 2, c: 3, d: 4 }
        result.append(defaults)
    end sub

    @test("no spread, 8 members: single literal")
    sub _()
        result = { x: 1, y: 2, a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 }
    end sub

    @test("no spread, 8 members: leading literal + append(defaults)")
    sub _()
        result = { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 }
        result.append(defaults)
    end sub

    @test("m.result, 1 member: sets")
    sub _()
        m.result = {}
        m.result.append(defaults)
        m.result.a = 1
    end sub

    @test("m.result, 1 member: sets on local temp, then assign")
    sub _()
        __bsc_tmp = {}
        __bsc_tmp.append(defaults)
        __bsc_tmp.a = 1
        m.result = __bsc_tmp
    end sub

    @test("m.result, 1 member: append literal")
    sub _()
        m.result = {}
        m.result.append(defaults)
        m.result.append({ a: 1 })
    end sub

