' Informs how BrighterScript lowers array elements that follow a spread:
'     result = [...defaults, 1, 2]
' Option A: one push per element       result.push(1) : result.push(2)
' Option B: one append of a literal    result.append([1, 2])
' The crossover point (if any) sets SPREAD_APPEND_THRESHOLD in the compiler.
@suite()
namespace SpreadTrailingElements
    sub setup()
        defaults = [10, 20]
    end sub

    @test("1 element: push")
    sub _()
        result = []
        result.append(defaults)
        result.push(1)
    end sub

    @test("1 element: append literal")
    sub _()
        result = []
        result.append(defaults)
        result.append([1])
    end sub

    @test("2 elements: push")
    sub _()
        result = []
        result.append(defaults)
        result.push(1)
        result.push(2)
    end sub

    @test("2 elements: append literal")
    sub _()
        result = []
        result.append(defaults)
        result.append([1, 2])
    end sub

    @test("3 elements: push")
    sub _()
        result = []
        result.append(defaults)
        result.push(1)
        result.push(2)
        result.push(3)
    end sub

    @test("3 elements: append literal")
    sub _()
        result = []
        result.append(defaults)
        result.append([1, 2, 3])
    end sub

    @test("4 elements: push")
    sub _()
        result = []
        result.append(defaults)
        result.push(1)
        result.push(2)
        result.push(3)
        result.push(4)
    end sub

    @test("4 elements: append literal")
    sub _()
        result = []
        result.append(defaults)
        result.append([1, 2, 3, 4])
    end sub

    @test("6 elements: push")
    sub _()
        result = []
        result.append(defaults)
        result.push(1)
        result.push(2)
        result.push(3)
        result.push(4)
        result.push(5)
        result.push(6)
    end sub

    @test("6 elements: append literal")
    sub _()
        result = []
        result.append(defaults)
        result.append([1, 2, 3, 4, 5, 6])
    end sub

    @test("8 elements: push")
    sub _()
        result = []
        result.append(defaults)
        result.push(1)
        result.push(2)
        result.push(3)
        result.push(4)
        result.push(5)
        result.push(6)
        result.push(7)
        result.push(8)
    end sub

    @test("8 elements: append literal")
    sub _()
        result = []
        result.append(defaults)
        result.append([1, 2, 3, 4, 5, 6, 7, 8])
    end sub
end namespace
