    @test("m.result, 1 element: push")
    sub _()
        m.result = []
        m.result.append(defaults)
        m.result.push(1)
    end sub

    @test("m.result, 1 element: push on local temp, then assign")
    sub _()
        __bsc_tmp = []
        __bsc_tmp.append(defaults)
        __bsc_tmp.push(1)
        m.result = __bsc_tmp
    end sub

    @test("m.result, 1 element: append literal")
    sub _()
        m.result = []
        m.result.append(defaults)
        m.result.append([1])
    end sub

    @test("m.result, 2 elements: push")
    sub _()
        m.result = []
        m.result.append(defaults)
        m.result.push(1)
        m.result.push(2)
    end sub

