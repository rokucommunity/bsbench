' Context for the lowering: hand-written single literal (no spread) vs the lowered forms.
@suite()
namespace SpreadBaseline
    sub setup()
        defaults = { x: 1, y: 2 }
    end sub

    @test("4 members: single literal, no spread")
    sub _()
        result = { x: 1, y: 2, a: 1, b: 2, c: 3, d: 4 }
    end sub

    @test("4 members: leading literal + append(defaults)")
    sub _()
        result = { a: 1, b: 2, c: 3, d: 4 }
        result.append(defaults)
    end sub

    @test("4 members: append(defaults) + sets")
    sub _()
        result = {}
        result.append(defaults)
        result.a = 1
        result.b = 2
        result.c = 3
        result.d = 4
    end sub

    @test("4 members: append(defaults) + append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ a: 1, b: 2, c: 3, d: 4 })
    end sub

    @test("8 members: single literal, no spread")
    sub _()
        result = { x: 1, y: 2, a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 }
    end sub

    @test("8 members: leading literal + append(defaults)")
    sub _()
        result = { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 }
        result.append(defaults)
    end sub

    @test("8 members: append(defaults) + sets")
    sub _()
        result = {}
        result.append(defaults)
        result.a = 1
        result.b = 2
        result.c = 3
        result.d = 4
        result.e = 5
        result.f = 6
        result.g = 7
        result.h = 8
    end sub

    @test("8 members: append(defaults) + append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 })
    end sub
end namespace
