' For a non-local target, is it cheaper to build in a local temp and assign once at the end?
@suite()
namespace SpreadTrailingMembersOnMViaTemp
    sub setup()
        defaults = { x: 1, y: 2 }
    end sub

    @test("1 members: direct sets on m.result")
    sub _()
        m.result = {}
        m.result.append(defaults)
        m.result.a = 1
    end sub

    @test("1 members: sets on local temp, then assign")
    sub _()
        __bsc_tmp = {}
        __bsc_tmp.append(defaults)
        __bsc_tmp.a = 1
        m.result = __bsc_tmp
    end sub

    @test("1 members: append literal on m.result")
    sub _()
        m.result = {}
        m.result.append(defaults)
        m.result.append({ a: 1 })
    end sub

    @test("2 members: direct sets on m.result")
    sub _()
        m.result = {}
        m.result.append(defaults)
        m.result.a = 1
        m.result.b = 2
    end sub

    @test("2 members: sets on local temp, then assign")
    sub _()
        __bsc_tmp = {}
        __bsc_tmp.append(defaults)
        __bsc_tmp.a = 1
        __bsc_tmp.b = 2
        m.result = __bsc_tmp
    end sub

    @test("2 members: append literal on m.result")
    sub _()
        m.result = {}
        m.result.append(defaults)
        m.result.append({ a: 1, b: 2 })
    end sub

    @test("4 members: direct sets on m.result")
    sub _()
        m.result = {}
        m.result.append(defaults)
        m.result.a = 1
        m.result.b = 2
        m.result.c = 3
        m.result.d = 4
    end sub

    @test("4 members: sets on local temp, then assign")
    sub _()
        __bsc_tmp = {}
        __bsc_tmp.append(defaults)
        __bsc_tmp.a = 1
        __bsc_tmp.b = 2
        __bsc_tmp.c = 3
        __bsc_tmp.d = 4
        m.result = __bsc_tmp
    end sub

    @test("4 members: append literal on m.result")
    sub _()
        m.result = {}
        m.result.append(defaults)
        m.result.append({ a: 1, b: 2, c: 3, d: 4 })
    end sub

    @test("8 members: direct sets on m.result")
    sub _()
        m.result = {}
        m.result.append(defaults)
        m.result.a = 1
        m.result.b = 2
        m.result.c = 3
        m.result.d = 4
        m.result.e = 5
        m.result.f = 6
        m.result.g = 7
        m.result.h = 8
    end sub

    @test("8 members: sets on local temp, then assign")
    sub _()
        __bsc_tmp = {}
        __bsc_tmp.append(defaults)
        __bsc_tmp.a = 1
        __bsc_tmp.b = 2
        __bsc_tmp.c = 3
        __bsc_tmp.d = 4
        __bsc_tmp.e = 5
        __bsc_tmp.f = 6
        __bsc_tmp.g = 7
        __bsc_tmp.h = 8
        m.result = __bsc_tmp
    end sub

    @test("8 members: append literal on m.result")
    sub _()
        m.result = {}
        m.result.append(defaults)
        m.result.append({ a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 })
    end sub
end namespace
