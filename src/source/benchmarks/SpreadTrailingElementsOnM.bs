' Target is `m.result`: each push re-evaluates `m.result`, append evaluates it once.
' Also checks whether building in a local temp and assigning once at the end is cheaper.
@suite()
namespace SpreadTrailingElementsOnM
    sub setup()
        defaults = [10, 20]
    end sub

    @test("1 elements: direct push on m.result")
    sub _()
        m.result = []
        m.result.append(defaults)
        m.result.push(1)
    end sub

    @test("1 elements: push on local temp, then assign")
    sub _()
        __bsc_tmp = []
        __bsc_tmp.append(defaults)
        __bsc_tmp.push(1)
        m.result = __bsc_tmp
    end sub

    @test("1 elements: append literal on m.result")
    sub _()
        m.result = []
        m.result.append(defaults)
        m.result.append([1])
    end sub

    @test("2 elements: direct push on m.result")
    sub _()
        m.result = []
        m.result.append(defaults)
        m.result.push(1)
        m.result.push(2)
    end sub

    @test("2 elements: push on local temp, then assign")
    sub _()
        __bsc_tmp = []
        __bsc_tmp.append(defaults)
        __bsc_tmp.push(1)
        __bsc_tmp.push(2)
        m.result = __bsc_tmp
    end sub

    @test("2 elements: append literal on m.result")
    sub _()
        m.result = []
        m.result.append(defaults)
        m.result.append([1, 2])
    end sub

    @test("4 elements: direct push on m.result")
    sub _()
        m.result = []
        m.result.append(defaults)
        m.result.push(1)
        m.result.push(2)
        m.result.push(3)
        m.result.push(4)
    end sub

    @test("4 elements: push on local temp, then assign")
    sub _()
        __bsc_tmp = []
        __bsc_tmp.append(defaults)
        __bsc_tmp.push(1)
        __bsc_tmp.push(2)
        __bsc_tmp.push(3)
        __bsc_tmp.push(4)
        m.result = __bsc_tmp
    end sub

    @test("4 elements: append literal on m.result")
    sub _()
        m.result = []
        m.result.append(defaults)
        m.result.append([1, 2, 3, 4])
    end sub

    @test("8 elements: direct push on m.result")
    sub _()
        m.result = []
        m.result.append(defaults)
        m.result.push(1)
        m.result.push(2)
        m.result.push(3)
        m.result.push(4)
        m.result.push(5)
        m.result.push(6)
        m.result.push(7)
        m.result.push(8)
    end sub

    @test("8 elements: push on local temp, then assign")
    sub _()
        __bsc_tmp = []
        __bsc_tmp.append(defaults)
        __bsc_tmp.push(1)
        __bsc_tmp.push(2)
        __bsc_tmp.push(3)
        __bsc_tmp.push(4)
        __bsc_tmp.push(5)
        __bsc_tmp.push(6)
        __bsc_tmp.push(7)
        __bsc_tmp.push(8)
        m.result = __bsc_tmp
    end sub

    @test("8 elements: append literal on m.result")
    sub _()
        m.result = []
        m.result.append(defaults)
        m.result.append([1, 2, 3, 4, 5, 6, 7, 8])
    end sub
end namespace
