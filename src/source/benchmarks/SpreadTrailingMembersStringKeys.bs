' Keys that are not identifiers lower to `result["k-1"] = 1` instead of a dotted set.
@suite()
namespace SpreadTrailingMembersStringKeys
    sub setup()
        defaults = { x: 1, y: 2 }
    end sub

    @test("2 string keys: indexed sets")
    sub _()
        result = {}
        result.append(defaults)
        result["k-1"] = 1
        result["k-2"] = 2
    end sub

    @test("2 string keys: append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ "k-1": 1, "k-2": 2 })
    end sub

    @test("4 string keys: indexed sets")
    sub _()
        result = {}
        result.append(defaults)
        result["k-1"] = 1
        result["k-2"] = 2
        result["k-3"] = 3
        result["k-4"] = 4
    end sub

    @test("4 string keys: append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ "k-1": 1, "k-2": 2, "k-3": 3, "k-4": 4 })
    end sub

    @test("8 string keys: indexed sets")
    sub _()
        result = {}
        result.append(defaults)
        result["k-1"] = 1
        result["k-2"] = 2
        result["k-3"] = 3
        result["k-4"] = 4
        result["k-5"] = 5
        result["k-6"] = 6
        result["k-7"] = 7
        result["k-8"] = 8
    end sub

    @test("8 string keys: append literal")
    sub _()
        result = {}
        result.append(defaults)
        result.append({ "k-1": 1, "k-2": 2, "k-3": 3, "k-4": 4, "k-5": 5, "k-6": 6, "k-7": 7, "k-8": 8 })
    end sub
end namespace
